# Backend Environment Configuration
# Copy this file to .env and provide your actual API keys.
# NEVER commit .env to GitHub.

# Groq Cloud API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Optional fallback, get at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Cloud API Key (Optional fallback)
OLLAMA_API_KEY=

# Supabase Database & Auth (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key
